# PocketBase backend
# dev default: http://127.0.0.1:8090 (iOS sim/web) or http://10.0.2.2:8090 (Android emulator)
# prod: https://api.stitchandwear.learnednomad.com
EXPO_PUBLIC_PB_URL=http://127.0.0.1:8090

# Seed script (scripts/seed-pocketbase.js) — superuser credentials
PB_URL=http://127.0.0.1:8090
PB_ADMIN_EMAIL=admin@stitchandwear.local
PB_ADMIN_PASSWORD=Admin12345!
SEED_DEMO_PASSWORD=Demo12345!

# --- Sentry crash reporting (https://starter.obytes.com/recipes/sentry-setup/) ---
# Client DSN (safe to expose; Sentry is disabled while this is empty and in dev builds)
EXPO_PUBLIC_SENTRY_DSN=
# Build-time: org/project slugs enable the @sentry/react-native/expo plugin
# (native crash handling + source-map upload during builds)
SENTRY_ORG=
SENTRY_PROJECT=
# Source-map upload auth: store as an EAS secret, never in this file:
#   eas secret:create --scope project --name SENTRY_AUTH_TOKEN --value <token> --type string

# --- Disabled integrations (scaffolded, no keys) ---

# OAuth Configuration - Google (disabled until keys exist)
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# SMS - Twilio (disabled until keys exist)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# --- Demo accounts (created by yarn seed) ---
# TAILOR=demo.tailor@stitchandwear.ng / Demo12345!
# CLIENT=demo.client@stitchandwear.ng / Demo12345!
